{
  "$schema": "https://go.kicad.org/api/schemas/v1",
  "identifier": "io.github.recepuysal.kicad-lcsc-importer",
  "name": "LCSC Parça Ekle",
  "description": "LCSC/JLCPCB parçalarını resim ve teknik bilgileriyle arayın, tek tıkla kütüphaneye ekleyip şematikte imlece getirin.",
  "runtime": { "type": "python" },
  "actions": [
    {
      "identifier": "open",
      "name": "LCSC Parça Ekle",
      "description": "LCSC parça arama penceresini açar",
      "show-button": true,
      "scopes": ["schematic", "pcb"],
      "entrypoint": "launch.py",
      "icons-light": ["icon.png", "icon48.png"],
      "icons-dark": ["icon.png", "icon48.png"]
    }
  ]
}
